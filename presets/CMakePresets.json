{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 16,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "host-debug",
            "displayName": "Host Debug (native)",
            "description": "Native host build for development and unit testing",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/host-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "host-release",
            "displayName": "Host Release (native)",
            "description": "Native host build for release verification",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/host-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ccu-dev-debug",
            "displayName": "CCU-Dev Debug (target)",
            "description": "Cross-compile debug build for CCU target using ccu-target toolchain",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ccu-dev-debug",
            "toolchainFile": "$env{CCU_ROOT}/cmake/toolchains/ccu-target.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "/usr",
                "CCU_SYSROOT": "$env{CCU_ROOT}/sysroots/ccu-dev-sysroot",
                "CCU_ROOT": "$env{CCU_ROOT}"
            },
            "environment": {
                "CCU_SYSROOT": "$env{CCU_ROOT}/sysroots/ccu-dev-sysroot"
            }
        },
        {
            "name": "ccu-dev-release",
            "displayName": "CCU-Dev Release (target)",
            "description": "Cross-compile release build for CCU target using ccu-target toolchain",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ccu-dev-release",
            "toolchainFile": "$env{CCU_ROOT}/cmake/toolchains/ccu-target.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INSTALL_PREFIX": "/usr",
                "CCU_SYSROOT": "$env{CCU_ROOT}/sysroots/ccu-dev-sysroot",
                "CCU_ROOT": "$env{CCU_ROOT}"
            },
            "environment": {
                "CCU_SYSROOT": "$env{CCU_ROOT}/sysroots/ccu-dev-sysroot"
            }
        }
    ],
    "buildPresets": [
        { "name": "host-debug",      "configurePreset": "host-debug" },
        { "name": "host-release",    "configurePreset": "host-release" },
        { "name": "ccu-dev-debug",   "configurePreset": "ccu-dev-debug" },
        { "name": "ccu-dev-release", "configurePreset": "ccu-dev-release" }
    ]
}
