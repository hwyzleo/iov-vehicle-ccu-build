[Unit]
Description=CCU Platform Aggregation Target (release-set level)
Documentation=https://app.notion.com/p/CCU-BUILD-SPEC-3b20ec7a4b92803fac49c7d11420a75e
# This unit aggregates all CCU services in a release set.
# It does not change single-service runtime semantics.
# Individual services define their own unit files and dependencies;
# this target only expresses the release-set composition so that
# `systemctl start ccu.target` brings up the full CCU stack.
#
# Wants= (not Requires=) is used deliberately: a single service failure
# must not prevent the rest of the stack from starting.

Wants=
  ccu-hello.service

After=
  ccu-hello.service

[Install]
WantedBy=multi-user.target
