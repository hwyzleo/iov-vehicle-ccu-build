[Unit]
Description=CGW Platform Aggregation Target (release-set level)
Documentation=https://app.notion.com/p/CGW-BUILD-SPEC-3b20ec7a4b92803fac49c7d11420a75e
# This unit aggregates all CGW services in a release set.
# It does not change single-service runtime semantics.
# Individual services define their own unit files and dependencies;
# this target only expresses the release-set composition so that
# `systemctl start cgw.target` brings up the full CGW stack.
#
# Wants= (not Requires=) is used deliberately: a single service failure
# must not prevent the rest of the stack from starting.

Wants=
  cgw-hello.service

After=
  cgw-hello.service

[Install]
WantedBy=multi-user.target
