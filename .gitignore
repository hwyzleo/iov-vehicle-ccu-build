# Prerequisites
# 注：`*.d` 是 CMake/Make 依赖文件后缀，但它同样会匹配平台资产目录名
# `conf.d` 与 `*.service.d`，从而把
# configs/<platform>/rootfs/etc/ccu/conf.d/** 及
# configs/<platform>/rootfs/usr/lib/systemd/system/*.service.d/**
# 整体忽略掉（CCU-BUILD-DSN-CR-003 §9.2 / CR-004 §3.1 平台资产无法入库）。
# 此处显式反忽略。
*.d
!configs/**/conf.d/
!configs/**/conf.d/**
!configs/**/*.service.d/
!configs/**/*.service.d/**

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/
cmake-build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# CCU Build output
out/
sysroots/
dependencies/cache/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

.idea/

graphify-out/
